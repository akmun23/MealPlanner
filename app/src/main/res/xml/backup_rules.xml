<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: android:allowBackup is false; this also excludes
     auth/session preferences and the local Room database from full backup. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
